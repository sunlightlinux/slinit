# Build binaries — `go build ./cmd/<name>` writes to repo root by
# default. Glob patterns rather than enumerated names so a new
# cmd/ subdirectory gets picked up automatically without another
# .gitignore edit. Anything matching these that IS intentional (a
# script named `slinit-something`) must be `git add -f`'d.
/slinit
/slinit-*
/slinitctl
/slinitctl-*
/rc-*
