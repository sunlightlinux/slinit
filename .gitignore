# Build binaries — `go build ./cmd/<name>` writes to repo root by
# default. Glob patterns rather than enumerated names so a new
# cmd/ subdirectory gets picked up automatically without another
# .gitignore edit. Anything matching these that IS intentional (a
# script named `slinit-something`) must be `git add -f`'d.
/slinit
/slinit-*
/slinitctl
/slinitctl-*
/rc-*

# Core dumps: slinit sends SIGABRT on the watchdog / timeout-abort
# paths, so a crashed test child can drop one in the package dir.
core
core.[0-9]*

# tools/stats builds to its own directory when run as
# `go build ./tools/stats` from there, and to the repo root otherwise.
# It is a 4 MB dev binary; neither copy belongs in a commit.
/stats
/tools/stats/stats
