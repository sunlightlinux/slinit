<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The actions slinit-localed asks polkit about. The ids and defaults
     are systemd-localed's, so rules written for one apply to the other:
     changing the system locale or keyboard needs an administrator. -->
<policyconfig>
  <vendor>slinit</vendor>
  <vendor_url>https://github.com/sunlightlinux/slinit</vendor_url>

  <action id="org.freedesktop.locale1.set-locale">
    <description>Set the system locale</description>
    <message>Authentication is required to set the system locale.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.imply">org.freedesktop.locale1.set-keyboard</annotate>
  </action>

  <action id="org.freedesktop.locale1.set-keyboard">
    <description>Set the system keyboard</description>
    <message>Authentication is required to set the system keyboard layout and console keymap.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
