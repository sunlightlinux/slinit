type = process
depends-on: system-init
# Timeout cluster: systemd-adjacent knobs stacked on one service.
#   timeout-sec                = start and stop timeout together
#   timeout-abort-sec          = SIGABRT phase between the stop timeout
#                                and SIGKILL
#   timeout-start-failure-mode = terminate (default)
#   timeout-stop-failure-mode  = terminate (default), which keeps the
#                                SIGABRT phase
# The process ignores SIGTERM and records SIGABRT, so a stop takes
# timeout-sec + timeout-abort-sec and leaves a marker.
timeout-sec                = 2
timeout-abort-sec          = 1
timeout-start-failure-mode = terminate
timeout-stop-failure-mode  = terminate
command = /bin/sh -c "trap '' TERM; trap 'echo abrt >> /run/183-abrt' ABRT; while :; do sleep 0.2; done"
