type = process
depends-on: system-init
# options-flags cluster A:
#   unmask-intr         — with runs-on-console, the console becomes the
#                         child's controlling terminal, so ^C reaches it
#   skippable           — parse coverage (scripted-only semantics)
#   start-interruptible — parse coverage; observed on a scripted
#                         service in case 249
options = runs-on-console unmask-intr skippable start-interruptible
command = /bin/sh -c "exec sleep 600"
