type = process
# Each attempt records the uptime (centisecond resolution) it started at.
command = /bin/sh -c "cut -d' ' -f1 /proc/uptime >> /tmp/backoff-times; exit 1"
restart = on-failure
# Delays: 0.3, 0.9, 1.5, then held at the 1.5 cap. Without the step every
# gap is 0.3; without the cap the fourth gap is 2.1.
restart-delay = 0.3
restart-delay-step = 0.6
restart-delay-cap = 1.5
restart-limit-count = 12
restart-limit-interval = 60
depends-on: system-init
