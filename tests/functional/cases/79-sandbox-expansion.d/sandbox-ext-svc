type = process
depends-on: system-init
depends-on: sandbox-prep
protect-home = tmpfs
inaccessible-paths = /opt
temporary-filesystem = /run/svc-scratch:size=4m,mode=0700
bind-paths = /var/tmp/sandbox-ext-rw
# Probe script:
#  - /opt must not show sandbox-prep's marker (inaccessible-paths)
#  - /home should be a fresh, empty, read-only tmpfs (protect-home=tmpfs,
#    read-only as in systemd)
#  - /run/svc-scratch should be a writable tmpfs (temporary-filesystem)
#  - /var/tmp/sandbox-ext-rw should be visible on host (bind-paths)
#
# All $ in this body are doubled ($$) so slinit's load-time env-var
# expansion leaves them alone and the shell sees a single '$'.
script
set -e
if [ -e /opt/sandbox-ext-marker ]; then opt=visible; else opt=hidden; fi
if echo home-probe > /home/home-probe 2>/dev/null && [ -f /home/home-probe ]; then
    home=writable
else
    home=blocked
fi
if echo scratch > /run/svc-scratch/scratch-probe 2>/dev/null && [ -f /run/svc-scratch/scratch-probe ]; then
    scratch=writable
else
    scratch=blocked
fi
if [ -z "$$(ls -A /home 2>/dev/null)" ]; then hempty=yes; else hempty=no; fi
echo "opt=$$opt home=$$home hempty=$$hempty scratch=$$scratch" > /var/tmp/sandbox-ext-rw/probe-result
exec sleep 600
end script
