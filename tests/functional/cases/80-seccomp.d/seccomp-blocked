type = process
depends-on: system-init
# Deny list: mount(2) must return EPERM. The body tries to mount a tmpfs
# and records busybox mount's verdict plus its stderr into a witness
# file. The service is root with every capability, so without the
# filter the mount SUCCEEDS — that is what makes the probe able to fail.
# (ptrace stays in the list as the second entry of a multi-name filter,
# but there is no strace in the guest to probe it with.)
#
# $ is doubled ($$) so slinit's load-time env-var expansion leaves
# shell variables alone.
system-call-filter = ~ptrace mount
system-call-error-number = EPERM
script
mkdir -p /run/seccomp-mnt
if mount -t tmpfs seccomp-probe /run/seccomp-mnt 2>/run/seccomp-mount-err; then
    result=mount-allowed
else
    result=mount-refused
fi
echo $$result > /tmp/seccomp-blocked-result
exec sleep 600
end script
