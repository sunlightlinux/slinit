type = process
depends-on: system-init
# Log-pipeline filters + forwarder knobs. log-level-max is observed:
# the <5> line must reach the file and the <7> one must not. The
# forwarder (no UDP listener here), log-sanitize, log-max-line-length and
# log-read-buffer-size are parse coverage.
logfile               = /tmp/185-filter.log
log-level-max         = notice
log-sanitize          = _
log-sanitize-extra    = 0x7f
log-max-line-length   = 4096
log-read-buffer-size  = 8192
log-forward-udp       = 127.0.0.1:9999
log-forward-format    = rfc5424
log-forward-facility  = daemon
log-forward-tag       = 185-filter
command = /bin/sh -c "echo '<7>debug-line'; echo '<5>notice-line'; exec sleep 600"
