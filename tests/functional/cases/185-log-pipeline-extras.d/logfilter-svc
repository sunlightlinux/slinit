type = process
depends-on: system-init
# Log-pipeline filters + forwarder knobs. All are parse-only in this
# fixture: log-forward-udp needs a UDP listener we don't have, and
# log-level-max / log-sanitize / log-max-line-length observably affect
# the log stream only on records matching their patterns. The point
# is that the loader accepts every combination and the service starts.
logfile               = /tmp/185-filter.log
log-level-max         = notice
log-sanitize          = _
log-sanitize-extra    = 0x7f
log-max-line-length   = 4096
log-read-buffer-size  = 8192
log-forward-udp       = 127.0.0.1:9999
log-forward-format    = rfc5424
log-forward-facility  = daemon
log-forward-tag       = 185-filter
command = /bin/sh -c "while true; do echo hello; sleep 1; done"
