type = process
depends-on: system-init
depends-on: sandbox-prep
private-tmp = yes
protect-system = yes
read-only-paths = /etc
read-write-paths = /etc/sandbox-rw
# A small probe script: write a file inside the private /tmp, attempt to
# write to /etc (must fail since protect-system=yes ro-remounts /usr,
# /boot, /efi but NOT /etc — so read-only-paths makes /etc ro). Drop a
# witness file describing what happened.
#
# /etc/sandbox-rw is the writable hole inside the read-only /etc: a
# write there succeeds only because of read-write-paths.
script
set -e
echo private > /tmp/sandbox-private
echo readwrite > /etc/sandbox-rw/marker
if echo nope > /etc/sandbox-escape 2>/dev/null; then
    echo etc-writable > /etc/sandbox-rw/result
else
    echo etc-protected > /etc/sandbox-rw/result
fi
exec sleep 600
end script
