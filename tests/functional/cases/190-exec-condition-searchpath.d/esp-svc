type = process
depends-on: system-init
# exec-search-path replaces the child's PATH. The child records the PATH
# it got: PID 1's own default PATH is different, so the file holding
# exactly this value is the directive's effect. ($$ keeps slinit from
# expanding PATH itself when it reads the command line.)
exec-search-path = /nonexistent:/bin
command = /bin/sh -c "echo $$PATH > /tmp/190-esp-path; exec sleep 600"
