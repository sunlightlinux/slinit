type = process
depends-on: system-init
# import-credential = <glob> copies matching credentials from the system
# credential stores (/etc/credstore, seeded by rootfs/ here) into the
# service's $CREDENTIALS_DIRECTORY. my-secret-a and my-secret-b match;
# other-x, in the same store, does not.
import-credential = my-secret-*
set-credential    = fallback:zero
command = /bin/sh -c "ls /run/credentials/importcred-svc/ > /tmp/191-creds 2>&1; cat /run/credentials/importcred-svc/my-secret-a > /tmp/191-secret-a 2>&1; exec sleep 600"
