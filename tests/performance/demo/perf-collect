# perf-collect -- demo/QEMU benchmark harness collector
#
# Runs after all-services reaches STARTED. Reads slinitctl boot-time,
# /proc/1/status (VmRSS/VmPeak/Threads/FDSize), and /sbin/slinit's
# on-disk size. Emits one marker line to the serial console then
# powers off the VM so the driver script (tests/performance/demo/
# cold-boot.sh) can measure the full boot→exit cycle wall-clock.
#
# Marker format is a single line, easy to grep + parse:
#
#   PERF-METRICS boot_ns=<int> kernel_ns=<int> userspace_ns=<int> \
#     pid1_rss_kb=<int> pid1_vmpeak_kb=<int> pid1_threads=<int> \
#     pid1_fds=<int> slinit_bytes=<int>
#
# All fields present, integers only, no floats — driver parses with
# awk. If any field is missing, driver reports the run as failed
# rather than substituting zero.
#
# Only bundled by tests/performance/demo/cold-boot.sh via a temporary
# copy into demo/services/ — NOT part of the default demo boot bundle.

type = scripted
depends-on: all-services
command = /bin/sh -c 'set -e; \
    _out=$$(slinitctl boot-time 2>/dev/null || echo ""); \
    _k_ns=$$(echo "$$_out" | awk -F"[()+=s]" "/Startup finished/ {gsub(\" \",\"\"); k=\$$4; u=\$$8; t=\$$12; printf \"k=%.6f u=%.6f t=%.6f\\n\", k, u, t; exit}" | awk "{for(i=1;i<=NF;i++){split(\$$i,a,\"=\"); if(a[1]==\"k\") printf \"%d\", a[2]*1e9}}"); \
    _u_ns=$$(echo "$$_out" | awk -F"[()+=s]" "/Startup finished/ {gsub(\" \",\"\"); u=\$$8; printf \"%d\", u*1e9; exit}"); \
    _t_ns=$$(echo "$$_out" | awk -F"[()+=s]" "/Startup finished/ {gsub(\" \",\"\"); t=\$$12; printf \"%d\", t*1e9; exit}"); \
    _rss=$$(awk "/^VmRSS:/{print \$$2}" /proc/1/status); \
    _peak=$$(awk "/^VmPeak:/{print \$$2}" /proc/1/status); \
    _thr=$$(awk "/^Threads:/{print \$$2}" /proc/1/status); \
    _fds=$$(ls /proc/1/fd 2>/dev/null | wc -l); \
    _bin=$$(stat -c %s /sbin/slinit 2>/dev/null || echo 0); \
    printf "PERF-METRICS boot_ns=%s kernel_ns=%s userspace_ns=%s pid1_rss_kb=%s pid1_vmpeak_kb=%s pid1_threads=%s pid1_fds=%s slinit_bytes=%s\n" \
        "$${_t_ns:-0}" "$${_k_ns:-0}" "$${_u_ns:-0}" "$${_rss:-0}" "$${_peak:-0}" "$${_thr:-0}" "$${_fds:-0}" "$${_bin:-0}"; \
    sync; \
    sleep 1; \
    slinitctl shutdown poweroff'
