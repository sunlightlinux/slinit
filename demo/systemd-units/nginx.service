# A stock nginx unit, in the shape distributions actually ship it —
# Type=forking with a PIDFile, ExecStop through nginx's own signalling, and
# a hardening block. Nothing here is written for slinit. ExecReload is in
# the unit too, and is one of the things slinit does not carry over — see
# below.
#
# It lives in /etc/systemd/system and is never converted to a file.
# slinit reads it at the moment something asks for "nginx" and runs it.
#
# Try, inside the VM:
#   slinitctl status nginx          # bgprocess, PID read from the pidfile
#   wget -qO- http://127.0.0.1/     # served from /var/lib/nginx/html
#   slinitctl reload nginx          # re-reads this file; does NOT run ExecReload
#
# slinitctl reload is not systemctl reload. It re-reads the service
# description from disk; the running daemon is left alone. slinit's
# equivalent of systemctl reload is `slinitctl reload-signal`, which needs
# a `reload-signal =` directive — and the converter cannot produce one,
# because ExecReload is a command to run and reload-signal is a signal to
# send. So ExecReload=/usr/sbin/nginx -s reload is reported as a note and
# dropped: under slinit this unit has no reload. nginx also reloads on
# SIGHUP, so a native description could carry `reload-signal = HUP`.
#   cat /etc/systemd/system/nginx.service
#
# `slinitctl shutdown softreboot --fast` logs one ERROR here:
#   Service 'nginx': stop-command exited with status 256, sending signal
# That is --fast keeping its word. It stops waiting for graceful stops, so
# `nginx -s quit` loses the race and exits 1; slinit then signals the
# daemon's process group, which stops nginx and its workers cleanly. A
# plain softreboot shows no error at all. Nothing to chase.
[Unit]
Description=nginx - high performance web server
Documentation=https://nginx.org/en/docs/
After=network.target

[Service]
Type=forking
PIDFile=/run/nginx/nginx.pid
# /run is a tmpfs, so the directory nginx writes its pidfile into has to
# be created at start. This is how a systemd unit says that, and slinit
# honours it — without it nginx exits before the pidfile appears and the
# bgprocess start times out.
RuntimeDirectory=nginx
ExecStart=/usr/sbin/nginx
ExecReload=/usr/sbin/nginx -s reload
ExecStop=/usr/sbin/nginx -s quit
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# Hardening. slinit implements these as equivalents of systemd's and
# translates them; PrivateDevices has no counterpart and is reported
# as a note rather than silently dropped.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
