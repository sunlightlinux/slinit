# A "heartbeat" service — proves multi-service journals work under -M.
# Named httpd historically (this demo originally used busybox httpd on
# :8080), but Alpine minirootfs strips the httpd applet so we swap in
# a pure /bin/sh loop that emits a distinctive line every 10 seconds.
# From the host: `slinit-journalctl -M alpine-demo -u httpd -f`
# shows the heartbeat stream.

type = process
command = /bin/sh -c 'i=0; while :; do i=$((i+1)); echo "HEARTBEAT #$i - httpd-substitute running healthy ($(date -u +%FT%TZ))"; sleep 10; done'
restart = yes
restart-delay-step = 2
restart-delay-cap = 30
log-type = buffer
