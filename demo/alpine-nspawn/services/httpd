# busybox httpd on port 8080, serving from /var/www (created lazily).
# Alpine ships busybox by default so httpd is already in the rootfs.
# The container's network namespace is shared with the host by
# default (no --private-network), so hitting http://localhost:8080
# from the host reaches this server.

type = process
command = /bin/sh -c 'mkdir -p /var/www && echo "<h1>Hello from Alpine inside slinit-nspawn</h1>" > /var/www/index.html && /usr/sbin/httpd -f -p 8080 -h /var/www'
restart = yes
restart-delay-step = 2
restart-delay-cap = 30
