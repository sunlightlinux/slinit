# A trivial "prove -M works" ticker. Every 5 seconds emits a line
# tagged with a fixed identifier so the host operator can filter for
# it via `slinit-journalctl -M alpine-demo -u ticker -f`.

type = process
command = /bin/sh -c 'i=0; while :; do i=$((i+1)); echo "TICK $i from inside the container ($(date -u +%FT%TZ))"; sleep 5; done'
restart = yes
restart-delay-step = 1
restart-delay-cap = 10
# Route stdout/stderr into slinit's journal so `slinit-journalctl -M
# alpine-demo -u ticker -f` surfaces each TICK line as an entry
# alongside the state-transition events.
#
# Mechanism: LogRotator's per-line processing loop calls
# emitJournalLogLine on every line it accepts (logrotate.go:620).
# LogRotator activates only when logfile= is set AND at least one
# processing knob is on — the logfile-max-size below flips it, so
# a bare 1M rotation ceiling is enough to arm the journal-emit
# path even though we don't care about rotation for a demo.
log-type = file
logfile = /var/log/slinit/ticker.log
logfile-max-size = 1M
