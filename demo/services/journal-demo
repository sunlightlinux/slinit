# journal-demo -- persistent journal daemon
#
# Runs slinit-journald so events fanned out by slinit itself (state
# transitions, log-forward lines, kmsg reader) get persisted to
# /run/slinit-journal/*.jsonl (volatile since the demo's initramfs
# has no /var/log persistence).
#
# Try it from the demo shell:
#
#   slinit-journalctl -n 20               # last 20 events
#   slinit-journalctl -u hello -o cat     # just the "hello" service's msgs
#   slinit-journalctl -p err              # errors only
#   slinit-journalctl -f                  # follow live
#   slinit-journalctl -o json | head -1   # raw JSON line
#   slinit-journalctl --list-boots        # current boot span
#   ls -la /run/slinit-journal/           # on-disk .jsonl + .idx
#
# The daemon is optional — everything above except --file also works
# without it (queries hit the in-process ring buffer). Persistence and
# `-f` fan-out to external subscribers are what the daemon adds.
type = process
command = /usr/sbin/slinit-journald --dir=/run/slinit-journal --volatile-dir=/run/slinit-journal --max-size=8388608 --max-age=1h
restart = on-failure
restart-limit-count = 5
restart-limit-interval = 30
depends-on: system-init
