# journal-demo -- persistent journal daemon (Phase B: binary + FSS)
#
# Runs slinit-journald with the Phase B binary format and FSS sealing
# enabled so operators can see the full systemd-journald-alike surface
# in the demo. Coexists with Phase C JSONL — flip `--format=jsonl` in
# the command below to fall back if needed.
#
# The FSS key at /etc/slinit/journal-key is minted at initramfs-build
# time by demo/build.sh (same shape as /etc/machine-id) so sealing
# works from the very first boot without any pre-start dance.
#
# Try it from the demo shell:
#
#   slinit-journalctl -n 20                                  # last 20 (via control)
#   ls -la /run/slinit-journal/                              # on-disk .journal + .idx
#   slinit-journalctl --file /run/slinit-journal/*.journal   # read the binary file directly
#   slinit-journalctl --file /run/slinit-journal/*.journal --verify   # walk FSS tag chain
#   slinit-journalctl -f                                     # follow live via control socket
type = process
# Wrap in /bin/sh so stderr can be tee'd to /run/journal-demo.err
# for post-mortem inspection when the daemon fails to start (softreboot
# scenarios where the previous instance left the journal file in a
# state new startup can't recover). Without this, exit 1 on the daemon
# tells us nothing — its own stderr is discarded by the process
# supervisor default. Cat /run/journal-demo.err to see the real error.
command = /bin/sh -c '/usr/sbin/slinit-journald --dir=/var/log/slinit-journal --volatile-dir=/run/slinit-journal --format=binary --fss-key=/etc/slinit/journal-key --max-size=8388608 --max-age=1h >/run/journal-demo.err 2>&1'
restart = on-failure
restart-limit-count = 5
restart-limit-interval = 30
depends-on: system-init
depends-on: persist-journal-mount
